# هذا المجلد يحتوي على جميع الأصول القابلة للاستبدال
# 
# الهيكل المطلوب:
# 
# /assets
# ├── /videos
# │   └── intro.mp4              # فيديو شاشة البداية
# │
# ├── /audio
# │   ├── menu-music.mp3         # موسيقى القائمة
# │   ├── select-game.mp3        # صوت اختيار لعبة
# │   ├── page-change.mp3        # صوت تغيير الصفحة
# │   ├── button-press.mp3       # صوت ضغط الأزرار
# │   └── number-button.mp3      # صوت أزرار الأرقام
# │
# ├── /images
# │   ├── menu-bg.png            # خلفية القائمة
# │   ├── game-bg.png            # خلفية أثناء اللعب
# │   ├── page-bg.png            # خلفية الصفحات
# │   │
# │   ├── /buttons               # صور أزرار 0-9
# │   │   ├── btn-0.png
# │   │   ├── btn-1.png
# │   │   └── ... (حتى btn-9.png)
# │   │
# │   └── /pages                 # صور الصفحات
# │       ├── page-01.png
# │       ├── page-02.png
# │       └── ... (حتى page-30.png)
# │
# └── /games                     # ملفات ROMs
#     ├── game-001.nes
#     ├── game-002.nes
#     └── ... (حتى game-300.nes)
